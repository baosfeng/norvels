# norvels 部署配置。复制成 .env 后按机器实际情况改：
#   cp .env.example .env
#
# 版本号：更新时改这里，然后跑 ./update.sh（或 docker compose pull && up -d）。
NORVELS_VERSION=0.2.0

# 数据目录（绝对路径，放独立数据盘）。容器内固定 /data。
# 首次启动前必须存在，且属主要能被容器内的 65532 用户写入。
NORVELS_DATA_DIR=/vol1/norvels/data

# 小说 txt 源目录，只读挂载。不导新书时可以指向一个空目录。
NORVELS_BOOKS_DIR=/vol1/norvels/books

# 宿主端口。8080 被占用就改这里。
NORVELS_PORT=8080

# 时区
TZ=Asia/Shanghai

# 鉴权令牌：局域网使用可留空；要从公网访问必须设置（随机长串）。
# NORVELS_AUTH_TOKEN=

# 存量书回填分类：0015 迁移给「加列前已入库的书」统一打上的分类名（它们没有来源目录可推断）。
# 不设时用中性默认值「未分类」。迁移只回填一次，之后导入的书按目录层级写入自己的分类。
# NORVELS_LEGACY_CATEGORY=
